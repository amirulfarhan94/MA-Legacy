{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist-hosting",
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/hs-og-neon.png", "destination": "/hs-og-2.jpg", "type": 301 },
      { "source": "/hs-og-image.png", "destination": "/hs-og-2.jpg", "type": 301 },
      { "source": "/hs-og-neon.jpg", "destination": "/hs-og-2.jpg", "type": 301 }
    ],
    "rewrites": [{ "source": "/a/**", "destination": "/app.html" }]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
